# Base URL of the backend API (Express server), including the /api/v1 prefix.
#
# Local dev:  leave this unset. The app falls back to the relative /api/v1 and Vite
#             proxies it to http://localhost:5000 (override with DEV_API_PROXY).
#
# Production: REQUIRED. Must be an https:// URL ending in /api/v1 — `vite build` fails
#             otherwise, so a localhost URL can never reach the live site again.
#             Set it on Netlify under Site settings -> Environment variables, then
#             redeploy with "Clear cache and deploy site" (Vite inlines it at build time).
#
# VITE_API_BASE_URL=https://himalayan-swoniga-backend.onrender.com/api/v1
