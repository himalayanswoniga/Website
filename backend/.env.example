# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/himalayan-swoniga?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=2h

# Cloudinary (free tier at cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated list of allowed frontend origins (Netlify URL + local dev)
CLIENT_ORIGINS=http://localhost:5173,https://your-site.netlify.app

# First admin user created by the seed script
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@himalayanswonigaharvest.com
ADMIN_PASSWORD=change-this-password
